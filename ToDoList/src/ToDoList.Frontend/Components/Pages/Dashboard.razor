@using System.Security.Permissions
@using Microsoft.VisualBasic
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models
@using Microsoft.AspNetCore.Components

@inject IToDoItemsClient todoItemsClient
@inject NavigationManager NavigationManager

<h3>Dashboard</h3>
<div>
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th><button @onclick="OrderById">Id</button></th>
                <th><button @onclick="OrderByName">Name</button></th>
                <th>Description</th>
                <th>IsCompleted</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in testData)
            {
                <tr class=@(item.IsCompleted ? "table-success" : "table-danger")>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Dokonceny" : "Nedokonceny")</td>
                    <td><button class="btn btn-success" @onclick="() => EditItem(item)">Edit</button>
                        <button class="btn btn-success" @onclick="() => ToggleItem(item)">
                            <i class=@ConvertItemCompletionToToggleIconStyle(item.IsCompleted)></i>
                        </button>
                        <button class="btn btn-danger" @onclick="() => DeleteItem(item)">
                            <i class="bi bi-x-square"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@code {
    private List<ToDoItemView> testData = new List<ToDoItemView>()
    {
        /*
        new ToDoItemView(1, "Nakoupit potraviny", "Mléko, chléb, vejce", false),
        new ToDoItemView(8, "Dokončit projekt", "Implementovat všechny funkce", true),
        new ToDoItemView(3, "Zavolat mamince", "Domluvit víkend", false),
        new ToDoItemView(4, "Cvičit", "Běhání v parku", false),
        new ToDoItemView(5, "Přečíst knihu", "Kapitola 5", true)*/
    };


    public void OrderByName()
    {
        testData = testData.OrderBy(item => item.Name).ToList();
    }

    public void OrderById()
    {
        testData = testData.OrderBy(item => item.Id).ToList();
    }

    public void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo($"editToDoItem/{toDoItem.Id}");
    }


    protected override async Task OnInitializedAsync()
    {
        testData = await todoItemsClient.ReadItemsAsync();
    }

    private async Task DeleteItem(ToDoItemView item)
    {
        await todoItemsClient.DeleteItemAsync(item);
    }

    private async Task ToggleItem(ToDoItemView item)
    {
        item.IsCompleted = !item.IsCompleted;
        await todoItemsClient.UpdateItemAsync(item);
    }

    private string ConvertItemCompletionToToggleIconStyle(bool isCompleted) => isCompleted ? "bi bi-check-square-fill" : "bi bi-check-square";

}