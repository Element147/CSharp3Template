@using System.Security.Permissions
@using Microsoft.VisualBasic
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models

@inject IToDoItemsClient todoItemsClient

<h3>Dashboard</h3>
<div>
    <table>
        <thead>
            <tr>
                <th><button @onclick="OrderById">Id</button></th>
                <th><button @onclick="OrderByName">Name</button></th>
                <th>Description</th>
                <th>IsCompleted</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in testData)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Dokonceny" : "Nedokonceny")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
@code {
    private List<ToDoItemView> testData = new List<ToDoItemView>()
    {
        /*
        new ToDoItemView(1, "Nakoupit potraviny", "Mléko, chléb, vejce", false),
        new ToDoItemView(8, "Dokončit projekt", "Implementovat všechny funkce", true),
        new ToDoItemView(3, "Zavolat mamince", "Domluvit víkend", false),
        new ToDoItemView(4, "Cvičit", "Běhání v parku", false),
        new ToDoItemView(5, "Přečíst knihu", "Kapitola 5", true)*/
    };


    public void OrderByName()
    {
        testData = testData.OrderBy(item => item.Name).ToList();
    }

    public void OrderById()
    {
        testData = testData.OrderBy(item => item.Id).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        testData = await todoItemsClient.ReadItemsAsync();
    }

}